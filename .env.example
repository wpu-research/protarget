# --- Host portları (bu makinedeki diğer projelerle çakışmasın diye varsayılan dışı) ---
POSTGRES_PORT=5544
REDIS_PORT=6390
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MAILPIT_SMTP_PORT=1125
MAILPIT_UI_PORT=8125
API_PORT=4100
WEB_PORT=3100

# --- Veritabanı ---
POSTGRES_USER=protarget
POSTGRES_PASSWORD=change-me
POSTGRES_DB=protarget
DATABASE_URL=postgresql://protarget:change-me@localhost:5544/protarget?schema=public

# --- Redis / kuyruk ---
REDIS_URL=redis://localhost:6390

# --- Object storage (S3 uyumlu) ---
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=protarget-creatives
S3_ACCESS_KEY=protarget
S3_SECRET_KEY=change-me-too
SIGNED_URL_TTL_SECONDS=1800

# --- Auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- E-posta ---
SMTP_HOST=localhost
SMTP_PORT=1125
MAIL_FROM=noreply@protarget.local

# --- Uygulama ---
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_LOCALE=tr
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
SENTRY_DSN=
CLAMAV_ENABLED=false
