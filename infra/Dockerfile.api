FROM node:24.22.2-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl postgresql-client ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@10.32.1
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec turbo run build --filter=@protarget/api...

FROM node:24.22.2-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl postgresql-client ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@10.32.1
WORKDIR /app
COPY --from=build --chown=node:node /app /app
USER node
ENV API_HOST=0.0.0.0 API_PORT=4100
EXPOSE 4100
CMD ["node", "apps/api/dist/main.js"]
