{
  "name": "protarget-pdooh",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "db:migrate": "pnpm --filter @protarget/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @protarget/api exec prisma migrate deploy",
    "db:generate": "pnpm --filter @protarget/api exec prisma generate"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
