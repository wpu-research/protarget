  "components": {
    "securitySchemes": {
      "protarget_access": {
        "type": "apiKey",
        "in": "cookie",
        "name": "protarget_access"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AcceptInviteDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 72
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateOrganizationDto": {
        "type": "object",
        "properties": {
          "brandName": {
            "type": "string",
            "nullable": true
          },
          "taxLegalLabel": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "spendVisible": {
            "type": "boolean"
          },
          "revenueShareVisible": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ADMIN",
              "AGENCY",
              "ADVERTISER",
              "MEDIA_OWNER"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "UpdateOrganizationDto": {
        "type": "object",
        "properties": {
          "brandName": {
            "type": "string",
            "nullable": true
          },
          "taxLegalLabel": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "spendVisible": {
            "type": "boolean"
          },
          "revenueShareVisible": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ADMIN",
              "AGENCY",
              "ADVERTISER",
              "MEDIA_OWNER"
            ]
          }
        }
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "AGENCY",
              "ADVERTISER",
              "SUPPORT"
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "InviteUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "AGENCY",
              "ADVERTISER",
              "SUPPORT"
            ]
          }
        },
        "required": [
          "email",
          "name",
          "orgId",
          "role"
        ]
      }
    }
  }
