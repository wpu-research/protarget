    "@prisma/client": "6.19.3",
    "@protarget/connectors": "workspace:*",
    "@protarget/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
